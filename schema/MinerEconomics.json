            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Burn History",
      "type": "array"
    },
    "chain": {
      "$ref": "#/$defs/ChainRef"
    },
    "earning_miners": {
      "title": "Earning Miners",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "immunity_blocks": {
      "title": "Immunity Blocks",
      "type": "integer"
    },
    "immunity_hours": {
      "title": "Immunity Hours",
      "type": "number"
    },
    "miners": {
      "title": "Miners",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "netuid": {
      "title": "Netuid",
      "type": "integer"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "payback_days": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Registration cost over the median earner's day",
      "title": "Payback Days"
    },
    "prune_bar_alpha_per_day": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Emission of the neuron the runtime would prune next; earn more than this to keep a seat",
      "title": "Prune Bar Alpha Per Day"
    },
    "prune_bar_tao_per_day": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prune Bar Tao Per Day"
    },
    "registration_cost_tao": {
      "title": "Registration Cost Tao",
      "type": "number"
    },
    "registrations_per_day": {
      "title": "Registrations Per Day",
      "type": "number"
    },
    "seat_turnover_hours": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "When full, hours between prunes at the registration rate the burn steers toward",
      "title": "Seat Turnover Hours"
    },
    "seats_max": {
      "title": "Seats Max",
      "type": "integer"
    },
    "seats_used": {
      "title": "Seats Used",
      "type": "integer"
    },
    "verdict": {
      "enum": [
        "promising",
        "competitive",
        "hard",
        "closed"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "chain",
    "netuid",
    "name",
    "verdict",
    "headline",
    "registration_cost_tao",
    "burn_history",
    "seats_used",
    "seats_max",
    "miners",
    "earning_miners",
    "alpha_price_tao",
    "bands",
    "immunity_blocks",
    "immunity_hours",
    "prune_bar_alpha_per_day",
    "prune_bar_tao_per_day",
    "registrations_per_day",
    "seat_turnover_hours",
    "payback_days",
    "notes",
    "findings"
