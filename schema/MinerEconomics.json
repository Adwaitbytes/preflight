        "$ref": "#/$defs/EarningsBand"
      },
      "title": "Bands",
      "type": "array"
    },
    "burn_history": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "integer"
          },
