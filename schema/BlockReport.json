        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "pallet": {
          "title": "Pallet",
          "type": "string"
        },
        "signer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signer"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "extrinsic_hash",
        "pallet",
        "call",
        "signer",
        "success"
