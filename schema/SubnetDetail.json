        "name": {
          "title": "Name",
          "type": "string"
        },
        "netuid": {
          "title": "Netuid",
          "type": "integer"
        },
        "operator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
