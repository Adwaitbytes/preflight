            }
          ]
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/Health"
            },
            {
              "type": "null"
            }
          ]
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubnetLive"
            },
            {
              "type": "null"
            }
          ]
        },
        "netuid": {
          "title": "Netuid",
          "type": "integer"
        }
      },
      "required": [
        "netuid",
        "catalog",
        "live",
        "health"
