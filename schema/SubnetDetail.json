        "id": {
          "description": "Rule id such as PF101",
          "title": "Id",
          "type": "string"
        },
        "rule": {
          "description": "Rule slug such as not_registered",
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule",
        "severity",
        "title",
        "evidence",
        "explanation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Fix": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "command",
            "code",
            "wait",
            "info"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "text": {
          "description": "The exact command or change, filled with the user's values",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Fix",
      "type": "object"
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "band": {
          "enum": [
            "healthy",
            "watch",
            "at_risk"
          ],
          "title": "Band",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/HealthFactor"
          },
          "title": "Factors",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "netuid": {
          "title": "Netuid",
          "type": "integer"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        }
      },
      "required": [
        "netuid",
        "score",
        "band",
        "factors",
        "findings"
      ],
      "title": "Health",
      "type": "object"
    },
    "HealthFactor": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "score",
        "weight",
        "value",
        "explanation"
      ],
      "title": "HealthFactor",
      "type": "object"
    },
    "Hyperparam": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "enum": [
            "Registration",
            "Weights",
            "Consensus",
            "Emissions",
            "Commit reveal",
            "Other"
          ],
          "title": "Group",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "who": {
          "enum": [
            "owner",
            "root",
            "chain"
          ],
          "title": "Who",
          "type": "string"
        }
      },
      "required": [
        "name",
        "group",
        "value",
        "meaning",
        "who"
      ],
      "title": "Hyperparam",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SubnetCard": {
      "additionalProperties": false,
