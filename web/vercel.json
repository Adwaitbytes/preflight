{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile && node scripts/vendor-api.mjs",
  "fluid": true,
  "rewrites": [{ "source": "/v1/:path*", "destination": "/api/index?__path=:path*" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.next/**,src/**,public/**,scripts/**}"
    }
  }
}
